<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/runtime_ripple">
    <item>
        <selector>
            <item android:state_selected="true" android:drawable="@color/runtime_selected" />
            <item android:state_activated="true" android:drawable="@color/runtime_selected" />
            <item android:state_focused="true" android:drawable="@color/runtime_selected" />
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
    <item android:id="@android:id/mask" android:drawable="@android:color/white" />
</ripple>
